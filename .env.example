# ==============================================================================
# ShopSphere Environment Configuration
# ==============================================================================

# Database Settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shopsphere
DB_USER=shopsphere_user
DB_PASS=change_me_to_secure_password

# Application Settings
APP_URL=http://localhost/shopsphere
APP_NAME=ShopSphere
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=UTC

# Session Settings
SESSION_LIFETIME=120
SESSION_SECURE=false

# SMTP Mail Settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@shopsphere.local
SMTP_FROM_NAME=ShopSphere

# Upload Settings (5MB in bytes)
UPLOAD_MAX_SIZE=5242880

# Currency & Marketplace Settings
CURRENCY=PKR
CURRENCY_SYMBOL=Rs.
DEFAULT_COMMISSION_RATE=10.00
